@using System.Diagnostics
@using EngrCAD.Mesh
@using EngrCAD.Viewer
@using EngrCAD.Web

@* ?example=<id> hands the whole page over to one documentation example. It is a branch
   rather than a route because the app has no router (static hosting would 404 a second
   path anyway) and because everything below -- the flange, the sliders, the ?report
   self-check and its committed numbers -- must stay exactly as it was. *@
@if (_exampleId is not null)
{
    <ExamplePage Id="@_exampleId" Embed="_embed" Report="_report" />
}
else
{
<div class="app @(_embed ? "embed" : null)">
    @if (!_embed)
    {
        <header>
            <h1>EngrCAD in the browser</h1>
            <p>
                The whole geometry kernel &mdash; B-Rep, implicit and mesh &mdash; compiled to
                WebAssembly, drawn by WebGL2. Nothing below is precomputed: the model is built,
                lowered to an exact B-Rep, tessellated and rendered in this tab. Drag to orbit,
                shift+drag to pan, scroll to zoom, click to select.
            </p>
        </header>
    }

    @* The tree and the status line are dropped under ?report so the self-check measures
       the largest canvas it can; the pixel checks below are relationships between states
       of the same canvas, so its exact size does not matter to them. *@
    @* Under ?report the cube and annotations start OFF like the furniture: the pixel
       classifiers predate both, and near-white cube labels / dimension strokes would
       land in the "steel" class and skew every comparative count. Their own checks
       turn them on through the direct setters, measure, and turn them back off. *@
    <EngrCadSceneView @ref="_view" Scene="_scene" Height="460px" Class="viewport"
                      ViewStyle="_style" Furniture="@(!_report)"
                      ShowTree="@(!_report)" ShowStatus="@(!_report)"
                      ShowViewCube="@(!_report)" ShowAnnotations="@(!_report)"
                      OnRendered="OnViewportRendered" />

    <section class="controls">
        <label>
            Bolt circle
            <input type="range" min="3" max="12" step="1" value="@_holes"
                   @onchange="OnHolesChanged" />
            <span class="value">@_holes holes</span>
        </label>
        <label>
            Rim fillet
            <input type="range" min="0" max="4" step="0.5" value="@_fillet"
                   @onchange="OnFilletChanged" />
            <span class="value">@_fillet.ToString("0.0") mm</span>
        </label>
        <label>
            View style
            <select value="@_style" @onchange="OnStyleChanged">
                @foreach (var style in Enum.GetValues<ViewStyle>())
                {
                    <option value="@style">@Spaced(style.ToString())</option>
                }
            </select>
        </label>
        <label>
            Flange
            <select value="@_flangeMode" @onchange="OnFlangeModeChanged">
                @foreach (var mode in Enum.GetValues<DisplayMode>())
                {
                    <option value="@mode">@mode</option>
                }
            </select>
        </label>
    </section>

    @if (_error is not null)
    {
        <pre class="error">@_error</pre>
    }
    else if (_result is null)
    {
        <p class="busy">Building&hellip;</p>
    }
    else
    {
        <table class="stats">
            <tbody>
                <tr><th>Triangles</th><td>@_result.Triangles.ToString("N0")</td></tr>
                <tr><th>Vertices</th><td>@_result.Vertices.ToString("N0")</td></tr>
                <tr><th>Closed</th><td>@(_result.Closed ? "yes" : "NO")</td></tr>
                <tr><th>Volume</th><td>@_result.Volume.ToString("N1") mm&sup3;</td></tr>
                <tr class="spacer"><td colspan="2"></td></tr>
                <tr><th>Build graph</th><td>@_result.BuildMs.ToString("N0") ms</td></tr>
                <tr><th>Lower to B-Rep</th><td>@_result.LowerMs.ToString("N0") ms</td></tr>
                <tr><th>Tessellate</th><td>@_result.MeshMs.ToString("N0") ms</td></tr>
                <tr class="total"><th>Total</th><td>@_result.TotalMs.ToString("N0") ms</td></tr>
            </tbody>
        </table>
    }

    @if (!_embed)
    {
        <footer>
            <p>
                The viewport compiles the <em>same</em> shader sources the desktop viewer and
                the headless renderer compile, moves the camera through the same
                <code>CameraMath</code>, resolves the view style against each part's own
                display mode through the same <code>RenderModes.Resolve</code>, and answers a
                click through the same <code>ScenePick</code> &mdash; so the three cannot drift
                apart. Try the <em>Assembly</em> tab: it shows the same two parts nested twice,
                and switching to it meshes and uploads nothing, because both parts are already
                on the GPU. Try <em>Section</em> in the toolbar: the cut is the same shader
                rule the desktop clips with, picking will not select the removed half, and the
                gold line on the cut face is the model's exact SDF cross-section. The view
                cube snaps the camera to standard views, and <em>BOM</em>/<em>Props</em>
                mirror the desktop panels.
            </p>
        </footer>
    }

    @if (_beacon is not null)
    {
        <img src="@_beacon" alt="" width="1" height="1" style="position:absolute; opacity:0" />
    }
</div>
}

@inject NavigationManager Nav

@code {
    private int _holes = 6;
    private double _fillet = 2;
    private ViewStyle _style = ViewStyle.ShadedWithEdges;
    private DisplayMode _flangeMode = DisplayMode.Shaded;
    private BuildResult? _result;
    private string? _error;
    private Scene? _scene;
    private Part? _flange;
    private Part? _backplate;

    // ?embed drops the page furniture so the docs site can put this in an iframe without
    // the heading and closing note appearing twice. ?report is the timing self-check below.
    private bool _embed;
    private bool _report;
    private string? _beacon;
    private string? _exampleId;

    private EngrCadSceneView? _view;
    private int _initialTab;
    private EngrCadViewport? Viewport => _view?.Viewport;
    private bool _pixelsChecked;

    private sealed record BuildResult(
        int Triangles, int Vertices, bool Closed, double Volume,
        double BuildMs, double LowerMs, double MeshMs)
    {
        public double TotalMs => BuildMs + LowerMs + MeshMs;
    }

    protected override void OnInitialized()
    {
        // NavigationManager, not a JS round trip: the query is known before the first
        // render, so ?embed takes effect without a flash of the full-page layout.
        var query = new Uri(Nav.Uri).Query;
        _embed = query.Contains("embed", StringComparison.Ordinal);
        _report = query.Contains("report", StringComparison.Ordinal);
        // ?tab=N deep-links a tab. It exists so a headless run can screenshot the
        // Assembly tab's tree: without a real click there is no other way in, and a
        // feature nothing can reach is a feature nothing checks.
        int at = query.IndexOf("tab=", StringComparison.Ordinal);
        if (at >= 0 && int.TryParse(query.AsSpan(at + 4, 1), out int tab))
            _initialTab = tab;
        // ?example=<id> shows one documentation example instead of the flange demo.
        int example = query.IndexOf("example=", StringComparison.Ordinal);
        if (example >= 0)
        {
            var rest = query.AsSpan(example + "example=".Length);
            int end = rest.IndexOf('&');
            _exampleId = Uri.UnescapeDataString((end < 0 ? rest : rest[..end]).ToString());
        }
    }

    /// <summary>
    /// The first build runs AFTER the first render, deliberately. WebAssembly is
    /// single-threaded: a build started in <c>OnInitialized</c> blocks the browser before
    /// it has painted anything, so the visitor sits on the static "Loading the kernel"
    /// placeholder for the whole ~1.7 s with no sign that the page is alive. Rendering
    /// the controls and a "Building..." line first costs nothing and makes the wait legible.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _exampleId is not null)
            return;
        await RebuildAsync();
        if (_initialTab > 0 && _view is not null)
            await _view.ShowTabAsync(_initialTab);
    }

    /// <summary>
    /// The <c>?report</c> self-check runs from here rather than after the page's own first
    /// render, because the interesting question now includes <em>did anything draw</em> —
    /// and only the viewport knows when its scene has finished meshing, uploading and
    /// drawing. Reading the canvas back and counting lit pixels is the only honest answer:
    /// a black canvas throws nothing, so an error-free console proves precisely nothing.
    ///
    /// <para>It walks every render mode, because a single count proves one mode drew
    /// something and says nothing about whether the modes DIFFER; the classifiers are
    /// deliberately the ones <c>ViewStyleRenderTests</c> uses against
    /// <c>OffscreenRenderer</c>, so the two front ends' numbers can be put side by side.
    /// It then checks picking, visibility and the selection highlight the same way — as
    /// RELATIONSHIPS between states of the same canvas, which is what survives a change of
    /// window size, and for picking against a second, independent fact.</para>
    /// </summary>
    private async Task OnViewportRendered()
    {
        // _flange is the guard that matters: the viewport reports a finished load for the
        // EMPTY scene it starts with (Furniture is off under ?report, and a furniture
        // change is a reload), and a check that ran then would measure a blank canvas
        // and set _pixelsChecked so the real one never ran.
        if (!_report || _pixelsChecked || _flange is null)
            return;
        _pixelsChecked = true;

        var counts = new Dictionary<string, int>();
        string buffer = "none";
        try
        {
            Trace("capture edges");
            var edges = await CaptureAsync(ViewStyle.ShadedWithEdges);
            buffer = $"{edges.Width}x{edges.Height}";
            // Above the background gradient (max 46/255): anything this bright is lit
            // geometry. Kept from the previous rung so the numbers stay comparable.
            counts["lit"] = edges.CountBrighterThan(90);

            Trace("capture shaded");
            var shaded = await CaptureAsync(ViewStyle.Shaded);
            counts["steelEdges"] = Steel(edges);
            counts["steelShaded"] = Steel(shaded);
            // The edge overlay is near-black over the same fill, so it must DARKEN pixels
            // and brighten almost none. Suppressing edges adding pixels would mean the two
            // styles differ in fill footprint, which they must not.
            counts["darkened"] = Darkened(edges, shaded);
            counts["brightened"] = Darkened(shaded, edges);

            Trace("capture wire");
            counts["steelWire"] = Steel(await CaptureAsync(ViewStyle.Wireframe));
            Trace("capture points");
            counts["steelPoints"] = Steel(await CaptureAsync(ViewStyle.Points));

            // Translucency: the hub sits under the flange and is hidden while the flange
            // is opaque. It is the only warm-coloured thing in the scene (furniture is off
            // under ?report), so warm pixels appearing IS the part behind showing through.
            Trace("capture translucency");
            await Viewport!.SetViewStyleAsync(ViewStyle.ShadedWithEdges);
            counts["warmOpaque"] = Warm(await Viewport.CapturePixelsAsync());
            _flange!.DisplayMode = DisplayMode.Translucent;
            await Viewport.RefreshDisplayModesAsync();
            var glass = await Viewport.CapturePixelsAsync();
            counts["warmGlass"] = Warm(glass);
            counts["steelGlass"] = Steel(glass);
            _flange.DisplayMode = DisplayMode.Shaded;
            await Viewport.RefreshDisplayModesAsync();

            await CheckPickingAsync(counts);
            await CheckVisibilityAndHighlightAsync(counts);
            await CheckTabSwitchAsync(counts);
            await CheckFieldSequenceAsync(counts);
            await CheckSectionAsync(counts);
            await CheckAnnotationsAsync(counts);
            await CheckViewCubeAsync(counts);

            // Then orbit through the same CameraMath call a drag makes and re-read the
            // canvas: a viewport that draws once but ignores the camera would pass every
            // check above and fail this one.
            Trace("orbit");
            var before = await Viewport.CapturePixelsAsync();
            await Viewport.SetCameraAsync(CameraMath.DragOrbit(Viewport.Camera, 220, 60));
            counts["moved"] = Differences(before, await Viewport.CapturePixelsAsync());
        }
        catch (Exception e)
        {
            buffer = $"{e.GetType().Name}:{e.Message}";
        }

        Trace("measure");
        _beacon = Measure(counts, buffer);
        Trace("beacon " + _beacon);
        // OnAfterRender deliberately does NOT re-render (that would loop), so the beacon
        // element only reaches the DOM if we ask for the repaint ourselves.
        StateHasChanged();
    }

    /// <summary>
    /// Picking, proved against the RASTERIZER rather than against itself.
    ///
    /// <para>The two parts are distinguishable by colour — the flange is bluish steel, the
    /// backplate amber — so the canvas already knows which part covers which pixel. Find a
    /// pixel of each class, pick there, and the answer must agree. A picker that always
    /// returned the first part, or one whose ray was flipped in y, passes "something was
    /// picked" and fails this.</para>
    ///
    /// <para>Then a second, independent fact per hit: the reported world point must lie
    /// inside the picked part's own world bounds. The bounds come from the kernel's
    /// geometry, not from the BVH the ray was traced against.</para>
    /// </summary>
    private async Task CheckPickingAsync(Dictionary<string, int> counts)
    {
        Trace("pick");
        var shot = await Viewport!.CapturePixelsAsync();
        var (cssWidth, cssHeight, scale) = await Viewport.ViewportSizeAsync();

        // Instance order in the Model tab is Tab.Instances() order: flange, then backplate.
        counts["pickSteel"] = await PickIndexAt(shot, cssHeight, scale, IsSteel);
        counts["pickWarm"] = await PickIndexAt(shot, cssHeight, scale, IsWarm);
        // The top-left corner is background in every pose this scene is framed at.
        counts["pickEmpty"] = (await Viewport.PickAtAsync(2, 2)).Index;

        counts["pickOnFlange"] = await PickOnSurface(shot, cssHeight, scale, IsSteel, _flange!);
        counts["pickOnBackplate"] = await PickOnSurface(shot, cssHeight, scale, IsWarm, _backplate!);
        _ = cssWidth;
    }

    /// <summary>Which instance the picker reports under the first pixel matching
    /// <paramref name="classify"/>, or −2 when the capture contains no such pixel (which
    /// would make the check vacuous rather than passing).</summary>
    private async Task<int> PickIndexAt(
        CapturedPixels shot, double cssHeight, double scale, Func<byte, byte, byte, bool> classify)
    {
        if (!TryFind(shot, cssHeight, scale, classify, out double x, out double y))
            return -2;
        return (await Viewport!.PickAtAsync(x, y)).Index;
    }

    /// <summary>1 when the picked world point lies inside <paramref name="part"/>'s own
    /// world bounds, 0 when it does not, −2 when no such pixel was found.</summary>
    private async Task<int> PickOnSurface(
        CapturedPixels shot, double cssHeight, double scale,
        Func<byte, byte, byte, bool> classify, Part part)
    {
        if (!TryFind(shot, cssHeight, scale, classify, out double x, out double y))
            return -2;
        var hit = await Viewport!.PickAtAsync(x, y);
        if (!hit.Hit)
            return 0;
        // Grown by a hair: the hit is ON the surface, so an exact-bounds test is a
        // knife-edge comparison against float32 vertex coordinates.
        var bounds = part.Bounds().Expanded(1e-6);
        return bounds.Contains(hit.World) ? 1 : 0;
    }

    /// <summary>
    /// The first captured pixel matching a classifier, converted to a click position.
    /// Two conversions, both easy to get wrong and both proved by the pick agreeing:
    /// <c>readPixels</c> returns rows BOTTOM-first, and the canvas is measured in device
    /// pixels while a pointer event is in CSS pixels.
    /// </summary>
    private static bool TryFind(
        CapturedPixels shot, double cssHeight, double scale,
        Func<byte, byte, byte, bool> classify, out double x, out double y)
    {
        x = y = 0;
        for (int i = 0; i + 3 < shot.Rgba.Length; i += 4)
        {
            if (!classify(shot.Rgba[i], shot.Rgba[i + 1], shot.Rgba[i + 2]))
                continue;
            int pixel = i / 4;
            int px = pixel % shot.Width;
            int py = pixel / shot.Width;
            x = (px + 0.5) / scale;
            y = cssHeight - (py + 0.5) / scale;
            return true;
        }
        return false;
    }

    /// <summary>
    /// Visibility and the highlight, as relationships between states of one canvas.
    ///
    /// <para>Hiding the flange must remove pixels; selecting it must change them WITHOUT
    /// changing the silhouette — which is why "body" (any channel bright) is counted
    /// separately from "steel" (bright and bluish). Selection blends the fill 55% toward
    /// gold, which takes it out of the steel class while leaving it bright, so the two
    /// counts moving in opposite directions is the signature of a highlight rather than
    /// of a re-render.</para>
    /// </summary>
    private async Task CheckVisibilityAndHighlightAsync(Dictionary<string, int> counts)
    {
        Trace("visibility");
        var plain = await Viewport!.CapturePixelsAsync();
        counts["bodyPlain"] = Body(plain);
        counts["steelPlain"] = Steel(plain);

        await Viewport.SetVisibleAsync(0, false);              // hide the flange
        var hiddenFlange = await Viewport.CapturePixelsAsync();
        counts["bodyFlangeHidden"] = Body(hiddenFlange);
        counts["steelFlangeHidden"] = Steel(hiddenFlange);
        await Viewport.SetVisibleAsync(1, false);              // hide the backplate too
        counts["bodyAllHidden"] = Body(await Viewport.CapturePixelsAsync());
        await Viewport.SetVisibilityAsync([true, true]);
        counts["bodyRestored"] = Body(await Viewport.CapturePixelsAsync());

        Trace("highlight");
        await Viewport.SelectAsync(0);
        var selected = await Viewport.CapturePixelsAsync();
        counts["bodySelected"] = Body(selected);
        counts["steelSelected"] = Steel(selected);
        counts["selectionChanged"] = Differences(plain, selected);

        await Viewport.SelectAsync(-1);
        await Viewport.HoverAtAsync(0, 0);   // reset, then hover the flange
        var (_, cssHeight, scale) = await Viewport.ViewportSizeAsync();
        if (TryFind(plain, cssHeight, scale, IsSteel, out double hx, out double hy))
        {
            await Viewport.HoverAtAsync(hx, hy);
            var hovered = await Viewport.CapturePixelsAsync();
            counts["bodyHovered"] = Body(hovered);
            counts["hoverChanged"] = Differences(plain, hovered);
            // FAINTER, measured rather than asserted. Both states change nearly every
            // pixel of the flange by at least a rounding step, so a plain difference
            // count cannot tell them apart; a threshold can. Selection blends the fill
            // 55% toward gold (red +63/255), hover 0.35 of that (red +22/255), so
            // counting pixels shifted by more than 40 separates them by construction.
            counts["selectShifted"] = Shifted(plain, selected, 40);
            counts["hoverShifted"] = Shifted(plain, hovered, 40);
            await Viewport.HoverAtAsync(0, 0);
        }
        await Viewport.SelectAsync(-1);
    }

    /// <summary>
    /// Switching tabs, timed. The Assembly tab places the SAME two parts four times, so
    /// nothing needs meshing or uploading — the elapsed time is the evidence for that,
    /// since a re-mesh of this flange costs the better part of a second. −1 means the
    /// switch never completed, which must not read as a fast one.
    /// </summary>
    private async Task CheckTabSwitchAsync(Dictionary<string, int> counts)
    {
        Trace("tab switch");
        var clock = Stopwatch.StartNew();
        await _view!.ShowTabAsync(1);
        for (int i = 0; i < 200 && Viewport!.InstanceCount != 4; i++)
            await Task.Delay(10);
        counts["tabSwitchMs"] = Viewport!.InstanceCount == 4 ? (int)clock.ElapsedMilliseconds : -1;
        counts["assemblyInstances"] = Viewport.InstanceCount;
        counts["bodyAssembly"] = Body(await Viewport.CapturePixelsAsync());
        await _view.ShowTabAsync(0);
        for (int i = 0; i < 200 && Viewport.InstanceCount != 2; i++)
            await Task.Delay(10);
    }

    /// <summary>
    /// Transient playback through the REAL browser buffer path — the check the value
    /// tests cannot make, because the colours-only re-upload ends in a JS
    /// <c>gl.bufferData</c> the .NET side never sees. The oracle is the batched
    /// export's A→B→A: stepping to the second result must CHANGE pixels
    /// (fieldStepPixels &gt; 0), and stepping back must restore the first capture
    /// EXACTLY (fieldStepReturn == 0) — a re-upload that leaked into any other buffer,
    /// or a stale cached colour array, fails one side or the other.
    /// </summary>
    private async Task CheckFieldSequenceAsync(Dictionary<string, int> counts)
    {
        Trace("field sequence");
        await _view!.ShowTabAsync(2);
        for (int i = 0; i < 200 && Viewport!.InstanceCount != 1; i++)
            await Task.Delay(10);
        counts["transientInstances"] = Viewport!.InstanceCount;

        var track = new FieldSequenceTrack([("T@0", 0), ("T@5", 5)]);
        await Viewport.SetAnimationAsync(new Animation(2).With(track));
        await Viewport.SetAnimationTimeAsync(0);
        var stepA = await Viewport.CapturePixelsAsync();
        await Viewport.SetAnimationTimeAsync(1);
        counts["fieldStepPixels"] = Differences(stepA, await Viewport.CapturePixelsAsync());
        await Viewport.SetAnimationTimeAsync(0);
        counts["fieldStepReturn"] = Differences(stepA, await Viewport.CapturePixelsAsync());

        await Viewport.SetAnimationAsync(null);
        await _view.ShowTabAsync(0);
        for (int i = 0; i < 200 && Viewport.InstanceCount != 2; i++)
            await Task.Delay(10);
    }

    /// <summary>
    /// Sections, as a relationship: cutting at the scene centre must REMOVE model
    /// pixels, and the SDF isolines must appear on the cut — gold is the d = 0
    /// cross-section, a colour nothing else in the report frame produces (amber fails
    /// the green floor, cut material the red one). X rather than Z so the plane
    /// crosses the backplate too, whose cylinder is implicit-Native and therefore
    /// guaranteed an isoline route.
    /// </summary>
    private async Task CheckSectionAsync(Dictionary<string, int> counts)
    {
        Trace("section");
        var whole = await Viewport!.CapturePixelsAsync();
        counts["bodyWhole"] = Body(whole);
        await Viewport.SetSectionAsync(true, SectionAxis.X);
        var cut = await Viewport.CapturePixelsAsync();
        counts["bodySectioned"] = Body(cut);
        counts["goldContours"] = Count(cut, IsGold);
        // The second single-plane reading (Y alone), for the quarter-cut bound below.
        await Viewport.SetSectionAsync(true, SectionAxis.Y);
        var cutY = await Viewport.CapturePixelsAsync();
        counts["goldContoursY"] = Count(cutY, IsGold);

        // The quarter cut: X and Y planes through the scene centre, Intersection. The
        // relationships that prove the per-plane sibling clip: a quarter cut removes
        // LESS material than either half cut (bodySectioned < bodyQuarter < bodyWhole),
        // each plane still shows gold isolines on its exposed cut face
        // (goldQuarter > 0), and each plane's isolines are CLIPPED to that exposed
        // half, so the total is strictly under the two full-extent readings summed
        // (goldQuarter < goldContours + goldContoursY — unclipped multi-plane overlays
        // would draw both planes' full extents and break that bound).
        var centre = Viewport.SceneBounds.Center;
        await Viewport.SetSectionPlanesAsync(
            [SectionPlane.On(SectionAxis.X, centre.X), SectionPlane.On(SectionAxis.Y, centre.Y)]);
        var quarter = await Viewport.CapturePixelsAsync();
        counts["bodyQuarter"] = Body(quarter);
        counts["goldQuarter"] = Count(quarter, IsGold);
        await Viewport.SetSectionPlanesAsync(null);
        await Viewport.SetSectionAsync(false);
    }

    /// <summary>The d = 0 isoline's gold — a colour nothing else in the report frame
    /// produces (amber fails the green floor, cut material the red one).</summary>
    private static bool IsGold(byte r, byte g, byte b) => r > 200 && g > 170 && b < 170 && r > b + 60;

    /// <summary>Annotations, as a relationship between two states of one canvas: the
    /// flange carries a real dimension, so toggling the overlay must change pixels.</summary>
    private async Task CheckAnnotationsAsync(Dictionary<string, int> counts)
    {
        Trace("annotations");
        var without = await Viewport!.CapturePixelsAsync();
        await Viewport.SetAnnotationsAsync(true);
        var with = await Viewport.CapturePixelsAsync();
        counts["annotationPixels"] = Differences(without, with);
        // An overlay may only ADD, so the silhouette must survive the toggle. A
        // difference count alone cannot say that, and the gap is not hypothetical: a
        // depth-clear regression (see the Web README) made the model VANISH when the
        // overlay went on, and `annotationPixels` rose from 786 to 34 317 while still
        // "firing" -- it was then measuring an erased model rather than a dimension.
        counts["annotationBody"] = Body(with);
        await Viewport.SetAnnotationsAsync(false);
    }

    /// <summary>
    /// The view cube: turning it on must light pixels in its top-right region, and a
    /// click on the region's centre must land the camera EXACTLY on a standard pose —
    /// the animation's final step returns the target, and the target comes from the
    /// shared pose table, so snapped-ness is checkable without naming which face was hit.
    /// </summary>
    private async Task CheckViewCubeAsync(Dictionary<string, int> counts)
    {
        Trace("view cube");
        await Viewport!.SetViewCubeAsync(true);
        var shot = await Viewport.CapturePixelsAsync();
        var (cssWidth, _, scale) = await Viewport.ViewportSizeAsync();
        int region = (int)Math.Ceiling(116 * scale);   // RegionSizeDip + margin + slack
        int lit = 0;
        for (int i = 0; i + 3 < shot.Rgba.Length; i += 4)
        {
            int pixel = i / 4;
            int px = pixel % shot.Width;
            int py = pixel / shot.Width;   // bottom-first: the top rows are the HIGH py
            if (px < shot.Width - region || py < shot.Height - region)
                continue;
            if (shot.Rgba[i] > 90 || shot.Rgba[i + 1] > 90 || shot.Rgba[i + 2] > 90)
                lit++;
        }
        counts["cubePixels"] = lit;

        // The region's centre in CSS pixels (margin 10, size 104 — the shared layout).
        bool claimed = await Viewport.ViewCubeClickAsync(cssWidth - 62, 62);
        counts["cubeClaimed"] = claimed ? 1 : 0;
        var camera = Viewport.Camera;
        var snapped = ViewCubeMath.PoseFor(
            ViewCubeMath.NearestStandardDirection(camera.Yaw, camera.Pitch), camera.Yaw);
        counts["cubeSnapped"] =
            Math.Abs(snapped.Yaw - camera.Yaw) < 1e-9 && Math.Abs(snapped.Pitch - camera.Pitch) < 1e-9
                ? 1 : 0;
        await Viewport.SetViewCubeAsync(false);
    }

    /// <summary>Blazor WASM routes Console.WriteLine to the browser console, which a
    /// headless run captures with --enable-logging=stderr. That is the only way to see
    /// WHERE a self-check stopped: the beacon reports the end, and a check that never
    /// reaches its end reports nothing at all.</summary>
    private static void Trace(string stage) => Console.WriteLine($"[engrcad-report] {stage}");

    /// <summary>Applies a view style and reads the canvas back. The style is applied
    /// through the viewport's own async setter for the reason that setter exists: a
    /// caller that set it and immediately captured would read the PREVIOUS frame.</summary>
    private async Task<CapturedPixels> CaptureAsync(ViewStyle style)
    {
        await Viewport!.SetViewStyleAsync(style);
        return await Viewport.CapturePixelsAsync();
    }

    // The pixel classifiers, transcribed from ViewStyleRenderTests so the browser's
    // numbers and the offscreen renderer's are the same measurement.

    /// <summary>Clearly bright steel — fills or full-intensity lines, bright and bluish.
    /// Used comparatively, never to tell a fill from a line: wireframe lines are steel
    /// coloured too.</summary>
    private static int Steel(CapturedPixels shot) => Count(shot, IsSteel);

    /// <inheritdoc cref="Steel"/>
    private static bool IsSteel(byte r, byte g, byte b) => r > 80 && b > 110 && b >= r;

    /// <summary>Warm pixels (red clearly above blue) — the Coral hub. The steel flange and
    /// the background gradient are both bluish, and furniture is off under ?report, so
    /// nothing else in the frame can produce one.</summary>
    private static int Warm(CapturedPixels shot) => Count(shot, IsWarm);

    /// <inheritdoc cref="Warm"/>
    private static bool IsWarm(byte r, byte g, byte b) => r > b + 15;

    /// <summary>Anything lit in ANY channel — the model's silhouette, whatever colour it
    /// is currently drawn in. The background gradient tops out at 46/255 and furniture is
    /// off under ?report, so this class is exactly "model". It is separate from
    /// <see cref="Steel"/> precisely so a colour change and a shape change can be told
    /// apart: selection must move the first and not the second.</summary>
    private static int Body(CapturedPixels shot) =>
        Count(shot, (r, g, b) => r > 90 || g > 90 || b > 90);

    /// <summary>Pixels where <paramref name="a"/> is darker than <paramref name="b"/> in
    /// green by more than anti-aliasing noise — how many pixels an overlay darkened.</summary>
    private static int Darkened(CapturedPixels a, CapturedPixels b)
    {
        if (a.Width != b.Width || a.Height != b.Height)
            return -1;
        int count = 0;
        for (int i = 0; i + 3 < a.Rgba.Length; i += 4)
        {
            if (b.Rgba[i + 1] - a.Rgba[i + 1] > 18)
                count++;
        }
        return count;
    }

    /// <summary>Pixels whose red channel moved by more than <paramref name="by"/> — a
    /// MAGNITUDE measure, where <see cref="Differences"/> counts any change at all.</summary>
    private static int Shifted(CapturedPixels before, CapturedPixels after, int by)
    {
        if (before.Width != after.Width || before.Height != after.Height)
            return -1;
        int count = 0;
        for (int i = 0; i + 3 < before.Rgba.Length; i += 4)
        {
            if (Math.Abs(before.Rgba[i] - after.Rgba[i]) > by)
                count++;
        }
        return count;
    }

    private static int Count(CapturedPixels shot, Func<byte, byte, byte, bool> predicate)
    {
        int count = 0;
        for (int i = 0; i + 3 < shot.Rgba.Length; i += 4)
        {
            if (predicate(shot.Rgba[i], shot.Rgba[i + 1], shot.Rgba[i + 2]))
                count++;
        }
        return count;
    }

    /// <summary>"ShadedWithEdges" as "Shaded with edges", for the dropdown.</summary>
    private static string Spaced(string name)
    {
        var text = new System.Text.StringBuilder(name.Length + 4);
        for (int i = 0; i < name.Length; i++)
        {
            if (i > 0 && char.IsUpper(name[i]))
                text.Append(' ').Append(char.ToLowerInvariant(name[i]));
            else
                text.Append(name[i]);
        }
        return text.ToString();
    }

    /// <summary>
    /// Repaints in the pending state, yields long enough for the browser to actually draw
    /// it, then builds. <c>Task.Delay(1)</c> rather than <c>Task.Yield()</c>: yielding
    /// posts the continuation straight back onto the same loop, which need not paint first.
    /// </summary>
    private async Task RebuildAsync()
    {
        _result = null;
        _error = null;
        StateHasChanged();
        await Task.Delay(1);
        Rebuild();
        StateHasChanged();
    }

    /// <summary>
    /// Headless self-check. Loading this page with <c>?report</c> re-runs the build a few
    /// times and returns a URL carrying the timings, which the page then requests as a 1x1
    /// image so the static server's access log records them.
    /// <para>
    /// It exists because in-page timing is otherwise unreadable from automation:
    /// <c>--dump-dom</c> fires at load, so the browser must be given
    /// <c>--virtual-time-budget</c> to reach the end of the work — and under virtual time
    /// the clock does not advance during a synchronous computation, so every measurement in
    /// the DOM reads 0 ms. A beacon is measured under REAL time and needs no DOM dump.
    /// </para>
    /// <para>
    /// An <c>&lt;img&gt;</c> rather than <c>fetch</c> through JS interop, deliberately: a
    /// beacon must not be able to fail. <c>IJSRuntime.InvokeVoidAsync("fetch", url)</c>
    /// marshals the JS <c>Response</c> back across the interop boundary and throws when it
    /// cannot, which loses the measurement AND trips Blazor's error UI — silently, since the
    /// numbers it was carrying are exactly what nobody has yet.
    /// </para>
    /// </summary>
    /// <summary>Pixels whose red channel differs between two captures of the same size.</summary>
    private static int Differences(CapturedPixels before, CapturedPixels after)
    {
        if (before.Width != after.Width || before.Height != after.Height)
            return -1;
        int count = 0;
        for (int i = 0; i + 3 < before.Rgba.Length; i += 4)
        {
            if (before.Rgba[i] != after.Rgba[i])
                count++;
        }
        return count;
    }

    private string Measure(Dictionary<string, int> counts, string buffer)
    {
        // Best of five: the first pass pays JIT/AOT warm-up and first-touch page faults,
        // which is exactly the "single warm-up is meaningless" lesson from the desktop
        // benchmarks, and it applies at least as strongly here.
        var best = double.PositiveInfinity;
        BuildResult? sample = null;
        for (int i = 0; i < 5; i++)
        {
            Rebuild();
            if (_result is null)
                break;
            if (_result.TotalMs < best)
            {
                best = _result.TotalMs;
                sample = _result;
            }
        }

        string pixels = string.Join("&", counts.Select(c => $"{c.Key}={c.Value}"));
        return sample is null
            ? $"/report?error={Uri.EscapeDataString(_error ?? "no result")}&{pixels}"
            : $"/report?best={best:F1}&build={sample.BuildMs:F1}&lower={sample.LowerMs:F1}"
              + $"&mesh={sample.MeshMs:F1}&tris={sample.Triangles}&closed={sample.Closed}"
              + $"&buffer={buffer}&{pixels}";
    }

    private async Task OnStyleChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<ViewStyle>(e.Value?.ToString(), out var style) && Viewport is not null)
        {
            // Both: the field so the next parameter flow supplies the same value, and the
            // viewport so the redraw happens now rather than on the next render cycle.
            _style = style;
            await Viewport.SetViewStyleAsync(style);
        }
    }

    private async Task OnFlangeModeChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<DisplayMode>(e.Value?.ToString(), out var mode)
            && _flange is not null && Viewport is not null)
        {
            _flangeMode = mode;
            // The mode lives on the PART, not on the viewport — so this is a model edit
            // followed by "pick it up", and it re-uploads nothing.
            _flange.DisplayMode = mode;
            await Viewport.RefreshDisplayModesAsync();
        }
    }

    private async Task OnHolesChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int holes))
        {
            _holes = holes;
            await RebuildAsync();
        }
    }

    private async Task OnFilletChanged(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out double fillet))
        {
            _fillet = fillet;
            await RebuildAsync();
        }
    }

    private void Rebuild()
    {
        _error = null;
        _result = null;

        try
        {
            // Wall clock via Stopwatch. Under WASM that is the browser's clock, whose
            // resolution every engine deliberately coarsens as a Spectre mitigation --
            // so these numbers are honest to a few milliseconds and no better.
            var t0 = Stopwatch.GetTimestamp();
            var shape = BuildFlange(_holes, _fillet);
            var t1 = Stopwatch.GetTimestamp();

            _ = shape.ToBrep();          // the exact lowering, cached for the mesh below
            var t2 = Stopwatch.GetTimestamp();

            // Through a Part, so the viewport draws the very geometry these numbers
            // describe: Part.GetMesh caches the display mesh the renderer then uploads.
            var part = new Part("Flange", shape, Palette.Steel) { DisplayMode = _flangeMode };
            var mesh = part.GetMesh();
            var t3 = Stopwatch.GetTimestamp();
            // A real dimension, so the annotation rung has something to draw (and the
            // ?report check something to toggle): the flange's 80 mm across, on its top.
            part.Annotate(new LinearDimension((-40, 0, 5), (40, 0, 5)));

            var scene = new Scene();
            var model = scene.AddTab("Model");
            model.Add(part);
            // The backing plate the flange bolts to, built AFTER the clock stops: it is a
            // plain cylinder and timing it would only dilute the numbers above, which
            // exist to measure the boolean / face-splitting / trimmed-tessellation paths.
            // Its radius (34) is inside the flange's (40) and it is only 4 thick, so it is
            // hidden under the flange except for the disc visible down the bore — which is
            // the whole point of having a translucent mode, and what the ?report check
            // measures. Amber rather than a palette colour because the check classifies it
            // by hue: at 0.4 alpha under steel, Coral lands at r-b = +8 and is
            // indistinguishable from noise, where this lands at +69.
            var backplate = new Part(
                "Backplate", Shape.Cylinder(34, 4).Translate(0, 0, -7), new PartColor(0.94f, 0.44f, 0.16f));
            model.Add(backplate);

            // A second tab, so the tab strip and the tree have a hierarchy to show. It
            // places the SAME two Part objects, which is the point worth noticing:
            // switching to it meshes nothing and uploads nothing, because uploads are
            // keyed by part reference and survive the tab switch.
            var stack = new Assembly("stack");
            stack.Add(part);
            stack.Add(backplate);
            var rig = new Assembly("rig");
            rig.Add(stack);
            rig.Add(stack, Frame3d.FromOrthonormal((110, 0, 0), Vector3d.UnitX, Vector3d.UnitY));
            scene.AddTab("Assembly").Add(rig);

            // Under ?report only: a third tab carrying a two-step transient fixture, so
            // the self-check can drive a FieldSequenceTrack through the REAL WebGL
            // buffer-update path (the readers' demo stays exactly the two tabs it was).
            if (_report)
            {
                var transient = new Part("Transient", Shape.Box(60, 30, 6));
                var transientMesh = transient.GetMesh();
                transient.AddResult(MeshField.Sample(transientMesh, "T@0", "K", q => 300 + q.X));
                transient.AddResult(MeshField.Sample(transientMesh, "T@5", "K", q => 300 + 4 * q.X));
                transient.FieldDisplay = new FieldDisplay { Field = "T@0" };
                scene.AddTab("Transient").Add(transient);
            }

            _scene = scene;
            _flange = part;
            _backplate = backplate;

            _result = new BuildResult(
                mesh.FaceCount, mesh.VertexCount, mesh.IsClosed, mesh.Volume(),
                Ms(t0, t1), Ms(t1, t2), Ms(t2, t3));
        }
        catch (Exception e)
        {
            // A kernel refusal is a real answer, not a crash: show it rather than
            // leaving the page blank.
            _error = $"{e.GetType().Name}: {e.Message}";
        }
    }

    private static double Ms(long from, long to) =>
        (to - from) * 1000.0 / Stopwatch.Frequency;

    /// <summary>A flange with a bolt circle and a filleted rim. Between them these
    /// exercise the boolean, face-splitting and trimmed-tessellation paths that dominate
    /// kernel time, so the timings mean something.</summary>
    private static Shape BuildFlange(int holes, double fillet)
    {
        var points = new List<Vector2d>(holes);
        for (int i = 0; i < holes; i++)
        {
            double angle = 2 * Math.PI * i / holes;
            points.Add(new Vector2d(28 * Math.Cos(angle), 28 * Math.Sin(angle)));
        }

        var body = Shape.Cylinder(40, 10) - Shape.Cylinder(14, 30);   // bored disc
        var top = SketchPlane.At((0, 0, 5), Vector3d.UnitX, Vector3d.UnitY);
        var drilled = body.Drill(StandardHoles.Clearance(6), points, depth: 14, top);

        return fillet > 0
            ? drilled.Fillet(fillet, s => s.PlanarFacesWithNormal(Vector3d.UnitZ))
            : drilled;
    }
}
