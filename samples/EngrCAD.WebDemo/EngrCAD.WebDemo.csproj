<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- TargetFramework / Nullable / ImplicitUsings / LangVersion come from
         Directory.Build.props, like every other project here. -->
    <IsPackable>false</IsPackable>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Static hosting under a repo subpath (GitHub Pages) needs a rewritable base
         path; kept explicit so the docs deployment can set it. -->
    <StaticWebAssetBasePath Condition="'$(StaticWebAssetBasePath)' == ''">/</StaticWebAssetBasePath>
    <!-- No ICU: the kernel parses and formats with InvariantCulture throughout, and the
         globalization data was 2.6 MB of the first measured payload. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EngrCAD.Web\EngrCAD.Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The live documentation examples (`?example=<id>`) load an assembly the docs build
         emitted and call into the kernel by reflection, so the trimmer cannot see what they
         will use. Today nothing is lost anyway — Blazor WebAssembly trims in `partial` mode,
         which leaves assemblies not marked `IsTrimmable` alone, and none of ours is — but
         that is a DEFAULT, and a feature whose correctness rests on one is a feature waiting
         for the default to change. Rooting them says it out loud and, measured, costs
         nothing: the published payload is byte-for-byte the same size with and without. -->
    <TrimmerRootAssembly Include="EngrCAD.Core" />
    <TrimmerRootAssembly Include="EngrCAD.Mesh" />
    <TrimmerRootAssembly Include="EngrCAD.Implicit" />
    <TrimmerRootAssembly Include="EngrCAD.BRep" />
    <TrimmerRootAssembly Include="EngrCAD.Interop" />
    <TrimmerRootAssembly Include="EngrCAD.Modeling" />
    <TrimmerRootAssembly Include="EngrCAD.Viewer.Core" />
  </ItemGroup>

</Project>
