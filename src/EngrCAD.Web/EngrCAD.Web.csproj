<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <Description>EngrCAD web viewer: a Blazor WebAssembly component that renders EngrCAD scenes with WebGL2, running the kernel in the browser.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- The kernel, and the UI-free half of the desktop viewer (shader sources, camera
         math, section rule). Deliberately NOT EngrCAD.Viewer: that drags Avalonia and
         desktop Silk.NET bindings, neither of which runs in WebAssembly. -->
    <ProjectReference Include="..\EngrCAD.Core\EngrCAD.Core.csproj" />
    <ProjectReference Include="..\EngrCAD.Mesh\EngrCAD.Mesh.csproj" />
    <ProjectReference Include="..\EngrCAD.Modeling\EngrCAD.Modeling.csproj" />
    <ProjectReference Include="..\EngrCAD.Viewer.Core\EngrCAD.Viewer.Core.csproj" />
  </ItemGroup>

</Project>
