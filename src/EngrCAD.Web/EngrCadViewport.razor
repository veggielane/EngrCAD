@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="engrcad-viewport @Class"
     style="position:relative; width:@Width; height:@Height; overflow:hidden; background:#1c1e22; @Style">
    <canvas @ref="_canvas"
            style="width:100%; height:100%; display:block; touch-action:none; cursor:@Cursor"
            @onpointerdown="OnPointerDown"
            @onpointermove="OnPointerMove"
            @onpointerup="OnPointerUp"
            @onpointercancel="OnPointerCancel"
            @onpointerleave="OnPointerLeave"
            @onwheel="OnWheel"
            @onwheel:preventDefault="true"
            @oncontextmenu:preventDefault="true"></canvas>

    @if (_message is not null)
    {
        <div style="position:absolute; left:0; right:0; bottom:0; padding:.45rem .7rem;
                    font:13px/1.4 'Segoe UI', system-ui, sans-serif; color:@(_failed ? "#e07b6b" : "#9aa0aa");
                    background:rgba(17,19,22,.82); pointer-events:none; white-space:pre-wrap">@_message</div>
    }
</div>

@code {
    // The browser front end of the viewport: it owns the canvas, the WebGL2 context and
    // the pointer bindings, and NOTHING about what a frame looks like. Every such
    // decision is made by ViewportFrame (this assembly, unit-tested) out of the shared
    // render core in EngrCAD.Viewer.Core -- the same shaders, camera maths, mode
    // precedence, highlight rule and pick maths the desktop window uses.
    //
    // The desktop's ViewportControl is the structural model: upload each distinct Part
    // once and draw its instances with their own matrices, auto-frame the first scene,
    // and redraw on demand rather than on a clock.

    /// <summary>The scene to draw. Tabs are shown ONE AT A TIME, as in the desktop
    /// viewer — <see cref="TabIndex"/> chooses which, and a tab is meshed the first time
    /// it is viewed rather than up front.</summary>
    [Parameter] public Scene? Scene { get; set; }

    /// <summary>One tab's contents, when a host drives the tab strip itself.</summary>
    [Parameter] public Tab? Tab { get; set; }

    /// <summary>Loose parts, each drawn at its own transform.</summary>
    [Parameter] public IReadOnlyList<Part>? Parts { get; set; }

    /// <summary>Already-posed instances (<c>Tab.Instances()</c>, <c>Assembly.Flatten()</c>).</summary>
    [Parameter] public IReadOnlyList<PartInstance>? Instances { get; set; }

    /// <summary>Which of <see cref="Scene"/>'s tabs to show. Switching tabs re-uses every
    /// upload a part already has, so revisiting one is instant.</summary>
    [Parameter] public int TabIndex { get; set; }

    /// <summary>Draw the ground grid and world axes (on, as in the desktop viewer).</summary>
    [Parameter] public bool Furniture { get; set; } = true;

    /// <summary>
    /// Global view style, as the desktop toolbar's dropdown sets it. A part whose
    /// <c>Part.DisplayMode</c> is explicitly non-default overrides it for that part;
    /// the precedence rule is <c>RenderModes.Resolve</c> and is not restated here.
    /// <para>Changing it redraws without re-uploading anything: every part's fills,
    /// feature edges and wire edges are all on the GPU already, which is what makes the
    /// switch instant.</para>
    /// </summary>
    [Parameter] public ViewStyle ViewStyle { get; set; } = ViewStyle.ShadedWithEdges;

    /// <summary>Click picking and the hover highlight (on). Turning it off leaves drags
    /// working and stops the raycast entirely.</summary>
    [Parameter] public bool Picking { get; set; } = true;

    /// <summary>
    /// Section mode: clips the model at the plane perpendicular to
    /// <see cref="SectionAxis"/> — the desktop toolbar's Section toggle. The clip runs
    /// in the SHARED shaders (fragment discard, cut interiors shaded as cut material
    /// via gl_FrontFacing), and picking honours it through the same
    /// <c>SectionClip.Hides</c> rule <c>ScenePick</c> applies, so a click cannot select
    /// the cut-away half. Parts with <c>Part.ClippedBySection</c> false render and pick
    /// whole (the unsectioned-fastener drafting convention).
    /// </summary>
    [Parameter] public bool SectionEnabled { get; set; }

    /// <summary>Which world axis the section plane is perpendicular to (Z — the classic
    /// horizontal cut, the desktop default).</summary>
    [Parameter] public SectionAxis SectionAxis { get; set; } = SectionAxis.Z;

    /// <summary>Plane position along the axis; null centers the cut in the scene
    /// bounds, the desktop's default when the toggle first goes on.</summary>
    [Parameter] public double? SectionOffset { get; set; }

    /// <summary>The view cube in the top-right corner (on, as on the desktop): clicks
    /// animate to the face/edge/corner view, dragging on it orbits and rotate-snaps to
    /// the nearest standard orientation on release, hovering brightens the target.</summary>
    [Parameter] public bool ShowViewCube { get; set; } = true;

    /// <summary>3D annotations (PMI) — dimensions, leaders, datum labels resolved from
    /// each part's own <c>Part.Annotations</c> (on, the desktop's Annot default).
    /// Rendering is the shared <c>AnnotationGeometry</c>: billboarded, screen-constant,
    /// always-on-top, never section-clipped. Hiding a part hides its annotations.</summary>
    [Parameter] public bool ShowAnnotations { get; set; } = true;

    /// <summary>CSS size of the viewport element.</summary>
    [Parameter] public string Width { get; set; } = "100%";

    /// <inheritdoc cref="Width"/>
    [Parameter] public string Height { get; set; } = "480px";

    /// <summary>Extra classes and inline style for the wrapper element.</summary>
    [Parameter] public string? Class { get; set; }

    /// <inheritdoc cref="Class"/>
    [Parameter] public string? Style { get; set; }

    /// <summary>Progress and failure messages, as the desktop status bar reports them.</summary>
    [Parameter] public EventCallback<string> OnStatus { get; set; }

    /// <summary>Raised once the whole scene has been meshed, uploaded and drawn — the
    /// only point at which <see cref="CapturePixelsAsync"/> sees a finished frame.</summary>
    [Parameter] public EventCallback OnRendered { get; set; }

    /// <summary>Raised when a CLICK changes the selection (−1 = nothing), never when a
    /// host calls <see cref="SelectAsync"/> — the desktop's <c>SelectionChanged</c> rule,
    /// and what keeps tree-to-viewport sync from echoing back into a loop.</summary>
    [Parameter] public EventCallback<int> SelectionChanged { get; set; }

    /// <summary>Raised when a part fails to mesh, with the part and the reason. A failed
    /// part is dropped from the instance list, so a host's tree must be told rather than
    /// left addressing indices that moved.</summary>
    [Parameter] public EventCallback<(Part Part, string Message)> PartFailed { get; set; }

    private ElementReference _canvas;
    private WebGlContext? _gl;

    /// <summary>The three geometry keys one distinct part is uploaded under, plus the
    /// pick BVH over its display mesh. All three uploads happen whatever the current
    /// style, so switching style is a redraw rather than a re-upload — the desktop's
    /// UploadShared makes the same trade.</summary>
    private sealed record PartKeys(
        string Mesh, string? Edges, int EdgeVertices, string? Wire, int WireVertices, PickMesh Pick);

    private readonly List<ViewportInstance> _drawn = [];
    // Parallel to _drawn: the part, instance and pose each entry came from. The parts
    // let a DisplayMode changed on the model be picked up without re-meshing; the
    // instances feed the section-isoline extraction; the pick instances are what
    // ScenePick raycasts.
    private readonly List<Part> _drawnParts = [];
    private readonly List<PartInstance> _drawnInstances = [];
    private readonly List<PickInstance> _pick = [];
    private readonly List<int> _pickScratch = [];

    private (bool Enabled, SectionAxis Axis, double? Offset) _shownSection = (false, SectionAxis.Z, null);
    private ViewportContours? _contours;

    // View cube state: the hovered direction (drives the face brighten), whether the
    // current drag started on the cube's screen region (arms rotate-snap on release),
    // and a token that cancels an in-flight pose animation when the user takes over.
    private Vector3d? _cubeHover;
    private bool _pressOnCube;
    private int _cameraAnimation;

    // Annotation state: per-instance resolved items (collected once per load — the
    // resolution rides Part.TryResolveAnnotations' cached lowering), the built
    // segments, and the AnnotationCamera the build is valid for. Value equality on the
    // camera is the rebuild key, the same rule the desktop AnnotationLayer keeps: an
    // orbit rebuilds, a static camera never does.
    private readonly List<(int Instance, AnnotationItem Item)> _annotationItems = [];
    private readonly List<AnnotationItem> _annotationScratch = [];
    private readonly List<(Vector3d A, Vector3d B)> _annotationSegments = [];
    private AnnotationCamera _builtAnnotationCamera;
    private bool _annotationsDirty = true;
    private bool _shownAnnotations = true;
    private bool _shownViewCube = true;
    // Parts whose implicit lowering failed and was already reported (the failure is
    // cached on the Part, so without this every rebuild repeats the status line —
    // the same dedupe the desktop SectionContourRenderer keeps).
    private readonly HashSet<Part> _reportedSectionFailures = [];

    // Uploads are keyed by Part REFERENCE and survive tab switches: a part shown in two
    // tabs is uploaded once, and revisiting a tab re-draws with no GPU work at all. Keys
    // therefore need a counter of their own rather than the dictionary's count, which
    // would repeat a key after a release.
    private readonly Dictionary<Part, PartKeys> _keys = [];
    private int _nextKey;

    private ViewportFurniture? _furniture;
    private double _gridSpacing;
    private Aabb _bounds = Aabb.Empty;

    private CameraState _camera = ViewportFrame.DefaultCamera(Aabb.Empty);
    private bool _userMovedCamera;

    private object? _loadedFrom;
    private bool _showingFurniture = true;
    private ViewStyle _shownStyle = ViewStyle.ShadedWithEdges;
    private int _generation;
    private bool _rendering;
    private bool _dirty;
    private bool _dragging;
    private bool _moved;
    private double _lastX, _lastY;
    private double _pressX, _pressY;
    private string? _message;
    private bool _failed;

    private int _selected = -1;
    private int _hovered = -1;
    private HoverThrottle _hoverThrottle = new(HoverThrottle.DefaultThreshold);

    /// <summary>The current orbit pose.</summary>
    public CameraState Camera => _camera;

    /// <summary>Index of the selected instance, −1 for none.</summary>
    public int Selected => _selected;

    /// <summary>Index of the hovered instance, −1 for none.</summary>
    public int Hovered => _hovered;

    /// <summary>How many instances the viewport is currently showing (a growing prefix
    /// while a tab loads).</summary>
    public int InstanceCount => _drawn.Count;

    private string Cursor => _dragging ? "grabbing" : _hovered >= 0 ? "pointer" : "grab";

    /// <summary>
    /// Moves the camera and draws. Async rather than a settable property because the draw
    /// is: a caller that set a pose and immediately read the canvas back would read the
    /// frame BEFORE the move, which is exactly the kind of quietly wrong result a
    /// self-check exists to catch. Setting a pose also stops first-scene auto-framing, so
    /// a host that chooses a view keeps it across a scene change.
    /// </summary>
    public Task SetCameraAsync(CameraState camera)
    {
        ArgumentNullException.ThrowIfNull(camera);
        _camera = CameraMath.Clamped(camera, _bounds);
        _userMovedCamera = true;
        return PumpAsync();
    }

    /// <summary>
    /// Applies a global view style and draws, for the same reason
    /// <see cref="SetCameraAsync"/> is a method: a caller that set the style and
    /// immediately read the canvas back would read the frame drawn in the OLD style.
    /// No upload happens — every part's fills, feature edges and wire edges are already
    /// on the GPU.
    /// <para>A host that also binds <see cref="ViewStyle"/> should update its own field
    /// alongside this call, so the next parameter flow supplies the same value.</para>
    /// </summary>
    public Task SetViewStyleAsync(ViewStyle style)
    {
        ViewStyle = style;
        _shownStyle = style;
        return PumpAsync();
    }

    /// <summary>
    /// Re-reads every drawn part's <c>DisplayMode</c> and draws. A display mode is a
    /// property of the model, not a parameter of this component, so changing one is
    /// invisible until something asks — and asking is cheap: the mode decides which
    /// already-uploaded buffers a frame references, never what is uploaded.
    /// </summary>
    public Task RefreshDisplayModesAsync()
    {
        for (int i = 0; i < _drawn.Count && i < _drawnParts.Count; i++)
            _drawn[i] = _drawn[i] with { Mode = _drawnParts[i].DisplayMode };
        return PumpAsync();
    }

    /// <summary>
    /// Sets the selection programmatically (a tree click) and draws. Does NOT raise
    /// <see cref="SelectionChanged"/> — that event means "the user clicked in the
    /// viewport", and raising it here would echo a tree selection straight back into the
    /// tree. The desktop's <c>Select</c> draws the same line.
    /// </summary>
    public Task SelectAsync(int index)
    {
        int wanted = index >= 0 && index < _drawn.Count ? index : -1;
        if (wanted == _selected)
            return Task.CompletedTask;
        _selected = wanted;
        return PumpAsync();
    }

    /// <summary>Shows or hides one instance and draws. Hidden instances keep their index
    /// (so nothing downstream shifts) and are not pickable.</summary>
    public async Task SetVisibleAsync(int index, bool visible)
    {
        if (index < 0 || index >= _drawn.Count || _drawn[index].Visible == visible)
            return;
        _drawn[index] = _drawn[index] with { Visible = visible };
        _pick[index] = _pick[index] with { Visible = visible };
        _annotationsDirty = true;       // hiding a part hides its annotations
        await RebuildContoursAsync();   // a hidden part's isolines go with it
        await PumpAsync();
    }

    /// <summary>
    /// Applies a whole visibility vector at once — what a model tree produces
    /// (<see cref="SceneTree.EffectiveVisibility"/>), where one checkbox can change many
    /// instances. Entries past the instance list are ignored, so a host may push a vector
    /// for the whole tab while the viewport is still showing a growing prefix.
    /// </summary>
    public async Task SetVisibilityAsync(IReadOnlyList<bool> visible)
    {
        ArgumentNullException.ThrowIfNull(visible);
        bool changed = false;
        for (int i = 0; i < _drawn.Count && i < visible.Count; i++)
        {
            if (_drawn[i].Visible == visible[i])
                continue;
            _drawn[i] = _drawn[i] with { Visible = visible[i] };
            _pick[i] = _pick[i] with { Visible = visible[i] };
            changed = true;
        }
        if (!changed)
            return;
        _annotationsDirty = true;
        await RebuildContoursAsync();
        await PumpAsync();
    }

    /// <summary>Whether an instance is currently shown.</summary>
    public bool IsVisible(int index) =>
        index >= 0 && index < _drawn.Count && _drawn[index].Visible;

    /// <summary>Frames the whole scene, as the toolbar's Fit does.</summary>
    public Task FitAsync()
    {
        _camera = ViewportFrame.DefaultCamera(_bounds);
        _userMovedCamera = false;
        return PumpAsync();
    }

    // ---- sections ----
    //
    // The clip rule itself is never restated here: the shaders carry it
    // (ViewerShaders.SectionClip), picking asks SectionClip.Hides through ScenePick,
    // and this component only decides WHICH plane is active — one axis-aligned plane,
    // like the desktop toolbar (custom hosts wanting quarter cuts drive
    // ViewportFrame.Build directly with more planes).

    /// <summary>The offset actually in use: the parameter, or the scene-bounds centre
    /// along the active axis (the desktop's default when the toggle goes on).</summary>
    public double EffectiveSectionOffset =>
        SectionOffset ?? (_bounds.IsEmpty ? 0 : AxisComponent(_bounds.Center, SectionAxis));

    private static double AxisComponent(in Vector3d v, SectionAxis axis) => axis switch
    {
        SectionAxis.X => v.X,
        SectionAxis.Y => v.Y,
        _ => v.Z,
    };

    private IReadOnlyList<SectionPlane>? ActiveSectionPlanes() =>
        SectionEnabled ? [SectionPlane.On(SectionAxis, EffectiveSectionOffset)] : null;

    /// <summary>
    /// Drives the section state directly (the toolbar's toggle/axis-cycle path, and how
    /// a test reaches it without a parameter flow). Changing the axis re-centers the
    /// plane — the desktop rule — unless <paramref name="offset"/> pins it.
    /// </summary>
    public Task SetSectionAsync(bool enabled, SectionAxis? axis = null, double? offset = null)
    {
        SectionEnabled = enabled;
        if (axis is { } wanted && wanted != SectionAxis)
        {
            SectionAxis = wanted;
            SectionOffset = null;   // changing the axis re-centers, as on the desktop
        }
        if (offset is { } o)
            SectionOffset = o;
        return ApplySectionAsync();
    }

    /// <summary>Moves the section plane by 2% of the scene extent along the active axis
    /// per step — the desktop's <c>[</c>/<c>]</c> nudge.</summary>
    public Task NudgeSectionAsync(int direction)
    {
        double extent = _bounds.IsEmpty ? 10 : AxisComponent(_bounds.Size, SectionAxis);
        SectionOffset = EffectiveSectionOffset + direction * extent * 0.02;
        return ApplySectionAsync();
    }

    private async Task ApplySectionAsync()
    {
        _shownSection = (SectionEnabled, SectionAxis, SectionOffset);
        await RebuildContoursAsync();
        await PumpAsync();
    }

    /// <summary>Shows or hides the annotation overlay and draws — the direct-call path
    /// for the toolbar and self-checks, for the reason <see cref="SetViewStyleAsync"/>
    /// is a method: a caller that flipped the parameter and immediately captured would
    /// read the previous frame.</summary>
    public Task SetAnnotationsAsync(bool show)
    {
        ShowAnnotations = show;
        _shownAnnotations = show;
        return PumpAsync();
    }

    // ---- view cube ----
    //
    // The pure halves are all shared (ViewCubeMath for region/hit/pose/snap,
    // ViewCubeAnimation for the 250 ms smoothstep transition, ViewCubeGeometry for the
    // arrays uploaded at init); this component only routes pointer events and runs the
    // animation loop, exactly the division the desktop's ViewCube keeps.

    /// <summary>The hovered cube direction (components in {-1,0,1}), or null.</summary>
    public Vector3d? CubeHover => _cubeHover;

    /// <summary>Shows or hides the view cube and draws (the direct-call path, like
    /// <see cref="SetViewStyleAsync"/>).</summary>
    public Task SetViewCubeAsync(bool show)
    {
        ShowViewCube = show;
        _shownViewCube = show;
        return PumpAsync();
    }

    /// <summary>
    /// Routes a click through the view cube: returns true when the position lies inside
    /// the cube's screen region — the region CLAIMS the click, so parts behind the
    /// widget are never picked through it (the desktop rule). When the cube itself was
    /// hit, animates to the face/edge/corner view and reports its name. Public for the
    /// reason the desktop's <c>ViewCubeClick</c> is: a state only reachable through a
    /// real pointer event is a state nothing checks.
    /// </summary>
    public async Task<bool> ViewCubeClickAsync(double x, double y)
    {
        var (width, height) = _lastSize;
        if (!ShowViewCube
            || !ViewCubeMath.TryMapToRegion(x, y, width, height, out double u, out double v))
            return false;
        if (ViewCubeMath.TryHit(_camera.Yaw, _camera.Pitch, u, v, out var direction))
        {
            await ReportAsync($"view {ViewCubeMath.Label(direction)}");
            var (yaw, pitch) = ViewCubeMath.PoseFor(direction, _camera.Yaw);
            await AnimateCameraAsync(yaw, pitch);
        }
        return true;
    }

    /// <summary>Rotate-snap: settles the camera onto the standard orientation nearest
    /// the current pose, the way commercial cubes finish a drag on the widget. Runs
    /// when a drag that STARTED on the cube ends, so free orbiting elsewhere in the
    /// viewport is untouched. Idempotent on an already-snapped pose.</summary>
    public async Task SnapToNearestViewAsync()
    {
        var direction = ViewCubeMath.NearestStandardDirection(_camera.Yaw, _camera.Pitch);
        await ReportAsync($"view {ViewCubeMath.Label(direction)}");
        var (yaw, pitch) = ViewCubeMath.PoseFor(direction, _camera.Yaw);
        await AnimateCameraAsync(yaw, pitch);
    }

    /// <summary>
    /// The eased pose transition — <c>ViewCubeAnimation</c>, whose default duration IS
    /// the product's 250 ms smoothstep, driven by a cooperative loop. A press or a
    /// newer animation bumps the token and the stale loop stops writing, so the user
    /// always wins over an animation.
    /// </summary>
    private async Task AnimateCameraAsync(double targetYaw, double targetPitch)
    {
        int token = ++_cameraAnimation;
        var animation = new ViewCubeAnimation(_camera.Yaw, _camera.Pitch, targetYaw, targetPitch);
        long start = System.Diagnostics.Stopwatch.GetTimestamp();
        while (true)
        {
            var (yaw, pitch, done) = animation.Evaluate(
                System.Diagnostics.Stopwatch.GetElapsedTime(start).TotalSeconds);
            if (token != _cameraAnimation)
                return;
            _camera = _camera with { Yaw = yaw, Pitch = pitch };
            _userMovedCamera = true;
            await PumpAsync();
            if (done)
                return;
            await Task.Delay(16);
        }
    }

    /// <summary>
    /// Runs one pick at a viewport-space position (CSS pixels from the canvas's top-left)
    /// and returns what was under it, WITHOUT changing the selection. Public because it is
    /// how a test or a host asks the question directly — and because a pick that reports
    /// its world point can be checked against something other than itself.
    /// </summary>
    public async ValueTask<PickResult> PickAtAsync(double x, double y)
    {
        if (_gl is null)
            return PickResult.None;
        var (width, height, _) = await _gl.ViewportSizeAsync();
        return PickAt(x, y, width, height);
    }

    /// <summary>
    /// Runs one hover update at a viewport-space position — the exact path a pointer move
    /// takes. Public for the reason the desktop's <c>HoverAt</c> is: hover state is
    /// otherwise only reachable through real pointer events, and a feature that can only
    /// be exercised by hand is a feature nothing checks.
    /// </summary>
    public Task HoverAtAsync(double x, double y) => UpdateHoverAsync(x, y);

    /// <summary>The canvas's CSS size and the device pixels per CSS pixel — browser facts
    /// a host needs to turn a captured pixel back into a click position.</summary>
    public ValueTask<(double Width, double Height, double PixelScale)> ViewportSizeAsync() =>
        _gl is null
            ? throw new InvalidOperationException("The viewport has no GL context yet.")
            : _gl.ViewportSizeAsync();

    /// <summary>
    /// Re-draws and reads the pixels back — the browser's screenshot, and the only honest
    /// way to assert that something was drawn (a black canvas raises no error).
    /// </summary>
    public ValueTask<CapturedPixels> CapturePixelsAsync() =>
        _gl is null
            ? throw new InvalidOperationException("The viewport has no GL context yet.")
            : _gl.CapturePixelsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _gl = await WebGlContext.CreateAsync(JS, new ElementReferenceLike(_canvas));
                // ES3 headers: WebGL2 IS OpenGL ES 3.0, which is why the desktop shader
                // sources compile here unchanged.
                string header = ViewerShaders.Header(es: true);
                await _gl.CreateProgramAsync(ViewportFrame.MeshProgram,
                    header + ViewerShaders.MeshVertex, header + ViewerShaders.MeshFragment);
                await _gl.CreateProgramAsync(ViewportFrame.LineProgram,
                    header + ViewerShaders.LineVertex, header + ViewerShaders.LineFragment);
                // gl_PointSize needs GL_PROGRAM_POINT_SIZE enabled on desktop GL. WebGL2
                // IS OpenGL ES 3.0, where that cap does not exist and point size is
                // always taken from the shader, so the shared source ports unchanged and
                // there is nothing to enable here.
                await _gl.CreateProgramAsync(ViewportFrame.PointProgram,
                    header + ViewerShaders.PointVertex, header + ViewerShaders.PointFragment);
                await _gl.CreateProgramAsync(ViewportFrame.BackgroundProgram,
                    header + ViewerShaders.BackgroundVertex, header + ViewerShaders.BackgroundFragment,
                    bindAttributes: false);
                // The view cube's geometry, uploaded once: the SAME arrays the desktop
                // widget uploads (ViewCubeGeometry), drawn through the line program —
                // fills in mode "triangles", edges and stroke-font labels as lines.
                await _gl.UploadLineVerticesAsync(
                    ViewportFrame.CubeFillsKey, ViewCubeGeometry.BuildFillVertices());
                await _gl.UploadLineVerticesAsync(
                    ViewportFrame.CubeEdgesKey, ViewCubeGeometry.BuildEdgeVertices());
                await _gl.UploadLineVerticesAsync(
                    ViewportFrame.CubeLabelsKey, ViewCubeGeometry.BuildLabelVertices());
            }
            catch (WebGlUnavailableException e)
            {
                await FailAsync($"WebGL2 is unavailable: {e.Message}");
                return;
            }
            catch (JSException e)
            {
                await FailAsync($"The viewport could not start: {e.Message}");
                return;
            }
        }

        if (_gl is null)
            return;

        if (!ReferenceEquals(Content, _loadedFrom) || _showingFurniture != Furniture)
        {
            _loadedFrom = Content;
            _showingFurniture = Furniture;
            _shownStyle = ViewStyle;
            _shownSection = (SectionEnabled, SectionAxis, SectionOffset);
            _shownAnnotations = ShowAnnotations;
            _shownViewCube = ShowViewCube;
            await LoadAsync();
            return;
        }

        // A style or section change needs no upload — every part's buffers are already
        // on the GPU and the clip is a shader uniform — so both are a redraw and
        // nothing more (the section change also refreshes the isoline overlay).
        bool redraw = false;
        if (_shownStyle != ViewStyle)
        {
            _shownStyle = ViewStyle;
            redraw = true;
        }
        if (_shownSection != (SectionEnabled, SectionAxis, SectionOffset))
        {
            _shownSection = (SectionEnabled, SectionAxis, SectionOffset);
            await RebuildContoursAsync();
            redraw = true;
        }
        if (_shownAnnotations != ShowAnnotations)
        {
            _shownAnnotations = ShowAnnotations;
            redraw = true;
        }
        if (_shownViewCube != ShowViewCube)
        {
            _shownViewCube = ShowViewCube;
            redraw = true;
        }
        if (redraw)
            await PumpAsync();
    }

    protected override void OnParametersSet()
    {
        // Refuse loudly rather than silently picking one: a host that set two of these
        // meant something by both, and quietly drawing the first is the wrong scene shown
        // with no complaint.
        int supplied = (Scene is null ? 0 : 1) + (Tab is null ? 0 : 1)
                     + (Parts is null ? 0 : 1) + (Instances is null ? 0 : 1);
        if (supplied > 1)
            throw new InvalidOperationException(
                "Set exactly one of Scene, Tab, Parts or Instances on EngrCadViewport.");
    }

    /// <summary>The tab a Scene is currently showing (clamped), or null.</summary>
    public Tab? CurrentTab =>
        Tab ?? (Scene is { Tabs.Count: > 0 } scene
            ? scene.Tabs[Math.Clamp(TabIndex, 0, scene.Tabs.Count - 1)]
            : null);

    /// <summary>
    /// What is being shown, as an identity a reload keys on. For a Scene that is the
    /// CURRENT TAB, not the scene: switching tabs must reload, and switching back must
    /// find every part already uploaded (which it does — <see cref="_keys"/> is keyed by
    /// part reference and survives).
    /// </summary>
    private object? Content =>
        (object?)CurrentTab ?? (object?)Instances ?? Parts;

    private IReadOnlyList<PartInstance> ResolveInstances()
    {
        if (Instances is not null)
            return Instances;
        if (CurrentTab is { } tab)
            return tab.Instances();
        if (Parts is not null)
            return [.. Parts.Select(p => new PartInstance(p, p.Transform, p.Name))];
        return [];
    }

    /// <summary>
    /// Meshes and uploads the current tab, publishing a growing prefix so the viewport is
    /// orbitable while the rest computes.
    ///
    /// <para><b>WebAssembly is single-threaded</b>, which is why this is not the desktop's
    /// <c>TabMeshLoader</c>. That class does its work on a thread-pool task and posts
    /// results back to the UI thread; here there is one thread, and the uploads it must
    /// interleave are awaited JS interop calls. So the same three rules are kept —
    /// publish a growing prefix, re-check a generation token after every await, name a
    /// part that throws rather than swallowing it — with cooperative yielding in place of
    /// the threading. <c>Task.Delay(1)</c>, not <c>Task.Yield()</c>, which posts straight
    /// back onto the same loop and need not paint.</para>
    ///
    /// <para><b>Uploads survive the switch.</b> Only parts no longer shown are released,
    /// so a tab revisit re-draws with no GPU work and a part placed in two tabs is
    /// uploaded once — the browser's version of "revisiting a tab is instant".</para>
    /// </summary>
    private async Task LoadAsync()
    {
        var gl = _gl;
        if (gl is null)
            return;

        // The generation token is re-checked after EVERY await that precedes a mutation,
        // not just once per part: a slider moved mid-load starts a second pass, and a
        // stale one that resumed between its upload and its bookkeeping would file a key
        // the new pass has already released.
        int generation = ++_generation;

        var instances = ResolveInstances();
        var wanted = new HashSet<Part>(instances.Select(i => i.Part));
        foreach (var (part, keys) in _keys.Where(e => !wanted.Contains(e.Key)).ToList())
        {
            await gl.ReleaseGeometryAsync(keys.Mesh);
            if (keys.Edges is not null)
                await gl.ReleaseGeometryAsync(keys.Edges);
            if (keys.Wire is not null)
                await gl.ReleaseGeometryAsync(keys.Wire);
            if (generation != _generation)
                return;
            _keys.Remove(part);
        }

        _drawn.Clear();
        _drawnParts.Clear();
        _drawnInstances.Clear();
        _pick.Clear();
        _contours = null;
        _annotationItems.Clear();
        _annotationsDirty = true;
        _bounds = Aabb.Empty;
        _gridSpacing = 0;
        _failed = false;
        _selected = -1;
        _hovered = -1;
        _hoverThrottle.Reset();

        for (int i = 0; i < instances.Count; i++)
        {
            var instance = instances[i];
            var part = instance.Part;
            if (!_keys.TryGetValue(part, out var keys))
            {
                await ReportAsync($"Meshing {part.Name} ({i + 1} of {instances.Count})...");
                await Task.Delay(1);
                if (generation != _generation)
                    return;
                try
                {
                    keys = await UploadPartAsync(gl, part, _nextKey++);
                }
                catch (Exception e)
                {
                    // A part that throws is NAMED and skipped, never swallowed: the rest
                    // of the scene still loads and the reason stays on screen. The host is
                    // told too, because its tree indexes instances and this part has none.
                    await FailAsync($"{part.Name}: {e.GetType().Name}: {e.Message}");
                    if (PartFailed.HasDelegate)
                        await PartFailed.InvokeAsync((part, $"{e.GetType().Name}: {e.Message}"));
                    continue;
                }
                if (generation != _generation)
                    return;
                _keys[part] = keys;
            }

            var worldBounds = instance.Bounds();
            // ClippedBySection is a property of the PART and rides on both the drawn
            // instance (per-draw uSectionEnabled override) and the pick instance
            // (ScenePick applies SectionClip.Hides), so render and pick cannot
            // disagree about a fastener standing whole in a cutaway.
            _drawn.Add(new ViewportInstance(
                keys.Mesh, instance.World, part.Color ?? Palette.Steel,
                worldBounds.IsEmpty ? Vector3d.Zero : worldBounds.Center,
                part.EffectiveDisplayMode,   // Ghost renders translucent, same as desktop
                keys.Edges, keys.EdgeVertices, keys.Wire, keys.WireVertices,
                Visible: true, ClippedBySection: part.ClippedBySection));
            _drawnParts.Add(part);
            _drawnInstances.Add(instance);
            _pick.Add(new PickInstance(keys.Pick, instance.World, true, part.ClippedBySection));
            _bounds = _bounds.Union(worldBounds);

            // The part's own annotations, posed by the instance transform (assembly
            // instances show their part's dimensions in place). Resolution rides the
            // part's cached lowering; a broken selector becomes a status message, not
            // a crash — the desktop's TryResolveAnnotations convention.
            if (part.Annotations.Count > 0)
            {
                if (part.TryResolveAnnotations(out var resolved, out string? annotationError))
                {
                    foreach (var annotation in resolved)
                        _annotationItems.Add((_drawn.Count - 1, new AnnotationItem(annotation, instance.World)));
                    _annotationsDirty = true;
                }
                else if (annotationError is not null)
                {
                    await ReportAsync($"{part.Name}: annotations: {annotationError}");
                }
            }

            if (!_userMovedCamera)
                _camera = ViewportFrame.DefaultCamera(_bounds);
            await RebuildFurnitureAsync(gl);
            if (generation != _generation)
                return;
            await PumpAsync();
        }

        if (SectionEnabled)
        {
            await RebuildContoursAsync();
            if (generation != _generation)
                return;
            await PumpAsync();
        }
        if (!_failed)
            await ReportAsync(null);
        if (OnRendered.HasDelegate)
            await OnRendered.InvokeAsync();
    }

    /// <summary>
    /// Uploads one distinct part's three buffers — the display mesh, its feature edges and
    /// every mesh edge — and builds the triangle BVH picking raycasts against.
    ///
    /// <para><b>All three go up whatever the current style</b>, mirroring the desktop
    /// window's <c>UploadShared</c> — the global style is a dropdown, and a viewport that
    /// re-meshed and re-uploaded to switch it would stall on every change. (The one-shot
    /// offscreen pass uploads only what its mode needs, because it has no dropdown.)</para>
    ///
    /// <para>Feature edges come from <c>Part.GetFeatureEdges</c>, which for a B-Rep-backed
    /// part reads the ACTUAL B-Rep edges sampled at display resolution rather than mesh
    /// dihedrals, so a bore rim stays a smooth circle however coarse the tessellation.
    /// Nothing about that is re-derived here; it rides the same cached lowering
    /// <c>GetMesh</c> already paid for.</para>
    ///
    /// <para>The pick BVH is built over the same <c>RenderMesh</c> that is uploaded, so a
    /// click lands on the triangle that was drawn rather than on a differently
    /// tessellated stand-in.</para>
    /// </summary>
    private static async Task<PartKeys> UploadPartAsync(WebGlContext gl, Part part, int index)
    {
        var mesh = part.GetMesh();
        var render = RenderMesh.CreateFlat(mesh);
        string meshKey = $"part{index}";
        await gl.UploadMeshAsync(meshKey, render.Positions, render.Normals, render.Indices);

        string? edgeKey = null;
        var featureEdges = part.GetFeatureEdges();
        if (featureEdges.Count > 0)
        {
            edgeKey = $"part{index}.edges";
            // Packed by the shared RenderGeometry.SegmentVertices, so the browser uploads
            // the same floats in the same order as both desktop passes.
            await gl.UploadLineVerticesAsync(edgeKey, RenderGeometry.SegmentVertices(featureEdges));
        }

        string? wireKey = null;
        var wireEdges = WireframeEdges.Extract(mesh);
        if (wireEdges.Count > 0)
        {
            wireKey = $"part{index}.wire";
            await gl.UploadLineVerticesAsync(wireKey, RenderGeometry.SegmentVertices(wireEdges));
        }

        return new PartKeys(
            meshKey, edgeKey, featureEdges.Count * 2, wireKey, wireEdges.Count * 2,
            PickMesh.Build(render));
    }

    /// <summary>
    /// The ground grid's 1-2-5 spacing is derived from the scene bounds, so it is rebuilt
    /// when they grow — the desktop's RebuildGrid rule. Publishing a growing prefix means
    /// the bounds grow once per part, but the *spacing* changes far less often, so the
    /// upload is keyed on the spacing rather than on the bounds.
    /// </summary>
    private async Task RebuildFurnitureAsync(WebGlContext gl)
    {
        if (!Furniture)
        {
            _furniture = null;
            return;
        }
        double spacing = RenderGeometry.NiceStep((_bounds.IsEmpty ? 10 : _bounds.Size.Length) / 10);
        if (spacing == _gridSpacing)
            return;
        _gridSpacing = spacing;

        var (grid, axes) = RenderGeometry.BuildGridAndAxes(_bounds);
        await gl.UploadLineVerticesAsync("@grid", grid);
        await gl.UploadLineVerticesAsync("@axes", axes);
        _furniture = new ViewportFurniture("@grid", grid.Length / 3, "@axes");
    }

    /// <summary>
    /// Recomputes and uploads the section-plane SDF isolines. The extraction is the
    /// shared <c>SectionContours.Build</c> — the same marching squares, the same cached
    /// <c>Part.TryGetSdf</c> route, the same lift below the plane and the same level
    /// spacing the desktop renderer uses — so this component only decides WHEN to
    /// rebuild: on a section change, a visibility change, or a load, never per frame.
    /// </summary>
    private async Task RebuildContoursAsync()
    {
        var gl = _gl;
        if (gl is null)
            return;
        if (!SectionEnabled || _drawnInstances.Count == 0)
        {
            _contours = null;
            return;
        }

        var visible = new bool[_drawnInstances.Count];
        for (int i = 0; i < visible.Length; i++)
            visible[i] = _drawn[i].Visible;

        // Failures are collected (the callback is synchronous) and reported after,
        // deduped per part: the lowering failure itself is cached on the Part, so
        // without the dedupe every rebuild would repeat the same status line.
        List<string>? failures = null;
        var geometry = SectionContours.Build(
            _drawnInstances, visible,
            SectionContours.PlaneFrame(SectionAxis.Direction(), EffectiveSectionOffset),
            (part, message) =>
            {
                if (_reportedSectionFailures.Add(part))
                    (failures ??= []).Add($"{part.Name}: {message}");
            });
        if (failures is not null)
            await ReportAsync(string.Join("\n", failures));

        if (geometry.PartCount == 0)
        {
            _contours = null;
            return;
        }
        await gl.UploadLineVerticesAsync("@contours.zero", geometry.ZeroVertices);
        await gl.UploadLineVerticesAsync("@contours.positive", geometry.PositiveVertices);
        await gl.UploadLineVerticesAsync("@contours.negative", geometry.NegativeVertices);
        _contours = new ViewportContours(
            "@contours.zero", geometry.ZeroVertices.Length / 3,
            "@contours.positive", geometry.PositiveVertices.Length / 3,
            "@contours.negative", geometry.NegativeVertices.Length / 3);
    }

    // ---- drawing ----
    //
    // On demand, like the desktop viewport: a frame is drawn when something changed, not
    // on a clock. Redraw requests that arrive while one is in flight coalesce into a
    // single follow-up, so a fast drag cannot queue a backlog of stale frames.

    private async Task PumpAsync()
    {
        if (_rendering)
        {
            _dirty = true;
            return;
        }
        _rendering = true;
        try
        {
            do
            {
                _dirty = false;
                await DrawAsync();
            }
            while (_dirty);
        }
        finally
        {
            _rendering = false;
        }
    }

    private async Task DrawAsync()
    {
        var gl = _gl;
        if (gl is null)
            return;
        try
        {
            // Asked per frame rather than cached: it is one direct call into the module,
            // and it makes a window resize just work instead of needing a ResizeObserver.
            var (width, height, pixelScale) = await gl.ViewportSizeAsync();
            if (width <= 0 || height <= 0)
                return;   // not laid out yet; the next request will find a real size
            _lastSize = (width, height);

            // The annotation overlay: rebuilt (and re-uploaded) only when the
            // AnnotationCamera VALUE or the item/visibility set changed — an orbit
            // rebuilds, a static camera never does. Billboarding is CPU-side, so the
            // upload is a few hundred small segments, well under one part draw.
            ViewportAnnotations? annotations = null;
            if (ShowAnnotations && _annotationItems.Count > 0)
            {
                var annotationCamera = AnnotationCamera.From(
                    _camera, orthographic: false, height * pixelScale, pixelScale);
                if (_annotationsDirty || annotationCamera != _builtAnnotationCamera)
                {
                    _annotationScratch.Clear();
                    foreach (var (index, item) in _annotationItems)
                    {
                        if (index < _drawn.Count && _drawn[index].Visible)
                            _annotationScratch.Add(item);
                    }
                    AnnotationGeometry.Build(_annotationSegments, _annotationScratch, annotationCamera);
                    await gl.UploadLineVerticesAsync(
                        "@annotations", RenderGeometry.SegmentVertices(_annotationSegments));
                    _builtAnnotationCamera = annotationCamera;
                    _annotationsDirty = false;
                }
                if (_annotationSegments.Count > 0)
                    annotations = new ViewportAnnotations("@annotations", _annotationSegments.Count * 2);
            }

            await gl.RenderAsync(ViewportFrame.Build(
                _drawn, _camera, _bounds, width / height, _furniture, ViewStyle, pixelScale,
                _selected, _hovered,
                sectionPlanes: ActiveSectionPlanes(), contours: _contours,
                cube: ShowViewCube ? new ViewportCube(width, height, _cubeHover) : null,
                annotations: annotations));
        }
        catch (JSDisconnectedException)
        {
            // The page is going away; there is nothing to draw on.
        }
        catch (JSException e)
        {
            await FailAsync($"Render failed: {e.Message}");
        }
    }

    // ---- picking ----
    //
    // Client-side: the kernel is in the browser, so a pick is a local BVH raycast and
    // never a round trip. The maths is ScenePick in EngrCAD.Viewer.Core -- the same call
    // the desktop viewport makes -- and deliberately NOT in engrcad-gl.js: a ray
    // unprojected in JavaScript is exactly the kind of thing that silently disagrees with
    // the camera the frame was drawn with.

    /// <summary>The canvas size the last frame was drawn at, so a pick can reuse it
    /// instead of asking the browser again mid-gesture.</summary>
    private (double Width, double Height) _lastSize = (1, 1);

    private PickResult PickAt(double x, double y, double width, double height)
    {
        var eye = CameraMath.Eye(_camera.Yaw, _camera.Pitch, _camera.Distance, _camera.Target);
        var (near, far) = CameraMath.FrustumPlanes(_camera.Distance, _bounds);
        var viewProjection = CameraMath.Perspective(Math.PI / 4, width / height, near, far)
                           * CameraMath.LookAt(eye, _camera.Target, Vector3d.UnitZ);
        // Picking honours the section planes through the SAME rule the shaders apply:
        // ScenePick asks SectionClip.Hides, and each PickInstance carries its part's
        // ClippedBySection — so a click cannot select the cut-away half, and an
        // unsectioned fastener stays clickable everywhere it is drawn.
        var planes = ActiveSectionPlanes();
        return ScenePick.Nearest(
            x, y, width, height, viewProjection, _pick,
            sectionEnabled: planes is not null, sectionPlanes: planes,
            scratch: _pickScratch);
    }

    /// <summary>A click: select what is under it, or clear the selection by clicking it
    /// again (the desktop's rule) or by clicking nothing.</summary>
    private async Task PickAndSelectAsync(double x, double y)
    {
        var (width, height) = _lastSize;
        int hit = PickAt(x, y, width, height).Index;
        int wanted = hit == _selected ? -1 : hit;   // clicking the selection clears it
        if (wanted != _selected)
        {
            _selected = wanted;
            await PumpAsync();
        }
        if (SelectionChanged.HasDelegate)
            await SelectionChanged.InvokeAsync(_selected);
    }

    private async Task UpdateHoverAsync(double x, double y)
    {
        if (!_hoverThrottle.ShouldSample(x, y))
            return;
        var (width, height) = _lastSize;
        await SetHoveredAsync(PickAt(x, y, width, height).Index);
    }

    private Task SetHoveredAsync(int index)
    {
        if (index == _hovered)
            return Task.CompletedTask;
        _hovered = index;
        StateHasChanged();   // the cursor is bound to the hover state
        return PumpAsync();
    }

    // ---- input ----
    //
    // The bindings match the desktop exactly because they ARE the desktop's: plain drag
    // orbits, shift (or right/middle) drag pans, ctrl+drag and the wheel zoom, and every
    // one of them is a call into CameraMath.

    private async Task OnPointerDown(PointerEventArgs e)
    {
        _dragging = true;
        _moved = false;
        _lastX = _pressX = e.OffsetX;
        _lastY = _pressY = e.OffsetY;
        _cameraAnimation++;   // the user takes over from any pose animation in flight
        // Remember whether the drag STARTED on the cube's screen region: that is what
        // arms rotate-snap on release (the desktop's rule), so orbiting from anywhere
        // else stays free.
        _pressOnCube = ShowViewCube && ViewCubeMath.TryMapToRegion(
            e.OffsetX, e.OffsetY, _lastSize.Width, _lastSize.Height, out _, out _);
        await SetHoveredAsync(-1);   // a press ends hover, as it does on the desktop
        if (_cubeHover is not null)
        {
            _cubeHover = null;
            await PumpAsync();
        }
        _hoverThrottle.Reset();
        // Capture, so a drag that leaves the canvas keeps orbiting. The desktop viewer
        // solves the same problem by handling input at the window level.
        if (_gl is not null)
            await _gl.CapturePointerAsync(new ElementReferenceLike(_canvas), e.PointerId);
    }

    private Task OnPointerMove(PointerEventArgs e)
    {
        if (!_dragging || e.Buttons == 0)
            return HoverMoveAsync(e.OffsetX, e.OffsetY);

        double dx = e.OffsetX - _lastX;
        double dy = e.OffsetY - _lastY;
        _lastX = e.OffsetX;
        _lastY = e.OffsetY;
        _moved |= Travelled(e.OffsetX - _pressX, e.OffsetY - _pressY);

        // Buttons is a bitmask: 1 primary, 2 secondary, 4 middle.
        bool pan = (e.Buttons & 6) != 0 || ((e.Buttons & 1) != 0 && e.ShiftKey);
        bool zoom = (e.Buttons & 1) != 0 && e.CtrlKey;

        _camera = pan ? CameraMath.DragPan(_camera, dx, dy)
            : zoom ? CameraMath.DragZoom(_camera, dy, _bounds)
            : CameraMath.DragOrbit(_camera, dx, dy);
        _userMovedCamera = true;
        return PumpAsync();
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        bool wasDragging = _dragging;
        _dragging = false;
        bool pressOnCube = _pressOnCube;
        _pressOnCube = false;
        // Click-vs-drag discrimination, the desktop's rule and its threshold: a release
        // within 4 pixels of the press is a click; anything farther was an
        // orbit/pan/zoom drag. Reusing HoverThrottle's distance is deliberate — the two
        // answer the same question about what counts as pointer travel.
        bool clicked = !_moved && !Travelled(e.OffsetX - _pressX, e.OffsetY - _pressY);
        if (wasDragging && pressOnCube)
        {
            _hoverThrottle.Reset();
            if (clicked)
                await ViewCubeClickAsync(e.OffsetX, e.OffsetY);   // the region claims the click
            else
                await SnapToNearestViewAsync();   // a drag that started on the cube snaps
            return;
        }
        if (wasDragging && Picking && clicked)
            await PickAndSelectAsync(e.OffsetX, e.OffsetY);
        _hoverThrottle.Reset();   // the next move re-picks immediately
    }

    /// <summary>
    /// A pointer move with no drag: over the cube's region, cube-face hover replaces
    /// model hover (the desktop suppresses model hover there too, and the widget's own
    /// hit test needs no throttle — it is a handful of flops); elsewhere, the model
    /// hover raycast behind the shared <c>HoverThrottle</c>.
    /// </summary>
    private async Task HoverMoveAsync(double x, double y)
    {
        var (width, height) = _lastSize;
        if (ShowViewCube && ViewCubeMath.TryMapToRegion(x, y, width, height, out double u, out double v))
        {
            Vector3d? hover =
                ViewCubeMath.TryHit(_camera.Yaw, _camera.Pitch, u, v, out var direction)
                    ? direction
                    : null;
            bool changed = !Nullable.Equals(hover, _cubeHover);
            _cubeHover = hover;
            _hoverThrottle.Reset();
            if (_hovered != -1)
                await SetHoveredAsync(-1);
            else if (changed)
                await PumpAsync();
            return;
        }
        if (_cubeHover is not null)
        {
            _cubeHover = null;
            await PumpAsync();
        }
        if (Picking)
            await UpdateHoverAsync(x, y);
    }

    private void OnPointerCancel(PointerEventArgs e) => _dragging = false;

    private Task OnPointerLeave(PointerEventArgs e) =>
        _dragging ? Task.CompletedTask : SetHoveredAsync(-1);

    private static bool Travelled(double dx, double dy) =>
        dx * dx + dy * dy >= HoverThrottle.DefaultThreshold * HoverThrottle.DefaultThreshold;

    private Task OnWheel(WheelEventArgs e)
    {
        _camera = CameraMath.WheelZoom(_camera, WheelNotches(e), _bounds);
        _userMovedCamera = true;
        return PumpAsync();
    }

    /// <summary>
    /// Browser wheel deltas in the units CameraMath expects: notches, positive toward the
    /// viewer. A DOM wheel event reports roughly 100 pixels per notch and counts DOWN as
    /// positive, the opposite of the desktop toolkit's convention, so this is the one
    /// place the two front ends legitimately differ — it is a browser fact, not a feel
    /// decision, and the feel decision behind it stays in CameraMath.WheelZoom.
    /// </summary>
    private static double WheelNotches(WheelEventArgs e) => e.DeltaMode switch
    {
        1 => -e.DeltaY / 3.0,     // DOM_DELTA_LINE
        2 => -e.DeltaY,           // DOM_DELTA_PAGE
        _ => -e.DeltaY / 100.0,   // DOM_DELTA_PIXEL
    };

    // ---- status ----

    private async Task ReportAsync(string? message)
    {
        _message = message;
        StateHasChanged();   // OnAfterRender does not re-render on its own
        if (message is not null && OnStatus.HasDelegate)
            await OnStatus.InvokeAsync(message);
    }

    private async Task FailAsync(string message)
    {
        _failed = true;
        await ReportAsync(message);
    }

    public async ValueTask DisposeAsync()
    {
        _generation++;   // any load still in flight stops at its next checkpoint
        if (_gl is not null)
            await _gl.DisposeAsync();
        _gl = null;
    }
}
