<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EngrCAD ECAD: code-defined schematics and the connectivity data model (components, pins, nets). The object graph IS the netlist; footprint, board placement and 3D body all derive from one declaration.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- Kernel-tier: Core for math (Vector2d), Modeling for the optional 3D body hook
         (Func<Shape>). Deliberately NO viewer/Avalonia dependency. Fea is a clean leaf
         (Core + Mesh only, no UI) and carries the thermal solver the board couples into
         (PcbThermal). -->
    <ProjectReference Include="..\EngrCAD.Modeling\EngrCAD.Modeling.csproj" />
    <ProjectReference Include="..\EngrCAD.Fea\EngrCAD.Fea.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EngrCAD.Ecad.Tests" />
  </ItemGroup>
</Project>
