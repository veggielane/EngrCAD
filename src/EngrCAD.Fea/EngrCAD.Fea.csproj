<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>EngrCAD simulation: tetrahedral meshing (constrained Delaunay + refinement) with quality reporting, sizing fields, facet tagging and 10-node quadratic elements; linear-static structural analysis (isotropic elasticity on 4- and 10-node tets, boundary conditions over facet selectors, sparse direct or iterative solve, stress recovery and results publishing); and heat conduction, steady and transient (held temperatures, flux, generation and convection, implicit theta-scheme stepping with one factorization per run, temperature and heat-flux fields), with thermal-expansion coupling back into the structural solve.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\EngrCAD.Core\EngrCAD.Core.csproj" />
    <ProjectReference Include="..\EngrCAD.Mesh\EngrCAD.Mesh.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="EngrCAD.Fea.Tests" />
  </ItemGroup>
</Project>
